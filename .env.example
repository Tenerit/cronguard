# ─────────────────────────────────────────────────────────────────────────────
# CronGuard — Configuration
#
# DEUX MODES :
#
#   Parfait pour développer sans Docker.
#
#   Remplis DATABASE_URL et REDIS_URL avec les vraies URLs.
#   Les variables doivent pointer vers localhost si Docker expose les ports.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
# Mot de passe Postgres. EN PROD : mettez une valeur forte (généré, pas "secret").
# docker-compose.yml l'exige (pas de défaut faible en prod) et construit la
# DATABASE_URL à partir d'elle. Pour un dev local sans Docker, gardez ce que vous voulez.
POSTGRES_PASSWORD=change-me-strong-password
# Hors Docker (connexion directe) :
DATABASE_URL=postgres://cronguard:change-me-strong-password@localhost:5432/cronguard

# ── Redis ────────────────────────────────────────────────────────────────────
# Avec Docker  = redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── LLM (optionnel) ──────────────────────────────────────────────────────────
# Sans LLM_BASE_URL (ou avec LLM_ENABLED=false) : pas d'analyse IA, mais corrections
# connues, lignes de log liées et mémoire des corrections restent actives.
# Avec Ollama  = http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# Modèles recommandés :
#   llama3.2:3b   — 2 GB, PAS de raisonnement, rapide (10-30s CPU) ← recommandé
#   qwen2.5:3b    — 2 GB, pas de raisonnement, très bon en JSON
#   gpu : qwen3:8b possible, mais ATTENTION sur CPU (voir note ci-dessous)
#
# ⚠ Les modèles qwen3 sont des modèles de RAISONNEMENT : ils génèrent 500-1500+
#   tokens de <think> avant la réponse. Sur CPU c'est très lent (80-190s) et le
#   budget LLM_MAX_TOKENS est mangé par le raisonnement → JSON vide. Ollama
#   0.30.x n'a aucun moyen fiable de désactiver ce raisonnement. Préférez un
#   modèle instruct (llama3.2, qwen2.5) sauf si vous avez un GPU.
LLM_MODEL=llama3.2:3b
LLM_MAX_TOKENS=512
LLM_TIMEOUT_MS=60000
# Sortie structurée : contraint le provider à répondre en JSON valide (response_format).
#   json_object (défaut) : JSON valide, large support (Ollama natif, OpenAI, Groq…).
#   json_schema           : contraint AUSSI les enums (category/severity/…) → aucune étiquette
#                           hors-liste. Gain et latence non établis (1 seul run). Reste opt-in :
#                           support plus étroit (certains providers OpenAI-compat le rejettent → 400).
#   off                   : aucun (provider qui rejette le champ, vieux vLLM). Anthropic non concerné.
LLM_JSON_MODE=json_object
# Budget tokens de la portion logs du prompt (en caractères, ~3.7c/token).
# Les lignes d'erreur dupliquées sont dédupliquées, chaque ligne est tronquée à 240c,
# puis le total est plafonné ici. Baisser sur un modèle cloud facturé au token.
LLM_LOG_BUDGET=2400
# Regroupement des lignes d'erreur par template (façon Drain, ON par défaut). Collapse
# les VARIANTES d'un même motif (« refused db1 »/« db2 » → « [×2] refused db1 ») là où le
# dédup exact ne collapse que les lignes identiques → moins de tokens, compteur = fréquence
# réelle. Mettre à false pour retomber sur le dédup exact (sert surtout à isoler son gain à l'éval).
LLM_TEMPLATE_MINING=true
# Nb max d'exemples few-shot injectés (0 = désactive le bloc). Chaque ex ≈ 100-150 tok.
LLM_FEWSHOT_MAX=2
# Cap (caractères) du runbook/notes opérateur injecté dans le prompt (0 = désactive).
LLM_RUNBOOK_BUDGET=800

# ── Mémoire d'incidents (RAG few-shot par similarité) ────────────────────────
# Le moat : embed les incidents validés (👍) et, à chaque panne, retrouve les plus
# SIMILAIRES comme exemples few-shot (meilleure pertinence que la récence). 100% local
# avec Ollama nomic-embed-text (~274 MB). ON par défaut — `setup.*` pull le modèle.
# Pour l'air-gappé minimaliste qui ne veut pas ce poids : passer à false.
# (Si le modèle d'embed est absent, l'embed échoue proprement → simple no-op, pas de casse.)
MEMORY_ENABLED=true
# EMBED_MODEL=nomic-embed-text
# EMBED_BASE_URL=http://localhost:11434/v1   # défaut = LLM_BASE_URL

# ── LLM cloud (optionnel — qualité supérieure) ───────────────────────────────
# ⚠ Un LLM cloud envoie vos logs hors du serveur : casse l'argument no-egress.
#   À n'activer que si la confidentialité n'est pas un enjeu.
#
# A) Endpoint OpenAI-compatible (le plus simple). LLM_API_KEY active l'auth Bearer
#    et désactive les checks/warm-up Ollama.
#   OpenAI     : LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=anthropic/claude-haiku-4-5
#   Groq       : LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=sk-...
#
# B) Anthropic NATIF (api.anthropic.com — auto-détecté, ou forcer LLM_PROVIDER=anthropic).
#    Utilise /v1/messages + x-api-key. Pas besoin d'OpenRouter.
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-haiku-4-5
#   LLM_API_KEY=sk-ant-...
#   LLM_PROVIDER=anthropic   # optionnel (auto-détecté depuis l'URL ; force si gateway custom)

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Signature des webhooks sortants (optionnel) ──────────────────────────────
# Si défini, chaque webhook générique sortant (alerte/rétablissement/escalade) est
# signé HMAC-SHA256. Le receveur vérifie X-CronGuard-Signature sur
# `${X-CronGuard-Timestamp}.${rawBody}`. Slack non concerné (schéma propre).
# WEBHOOK_SIGNING_SECRET=
# Garde anti-SSRF des webhooks sortants : loopback + link-local + métadonnées cloud
# (169.254.169.254) sont TOUJOURS bloqués. Mettre =true pour bloquer aussi les plages
# privées RFC1918 (10/172.16/192.168) — recommandé en SaaS multi-tenant, laisser off
# en self-host/air-gapped (vos récepteurs internes type n8n y vivent).
# WEBHOOK_BLOCK_PRIVATE=false

# ── Rate limiting ────────────────────────────────────────────────────────────
LLM_RATE_LIMIT_PER_CLIENT=10
LLM_GLOBAL_RATE_LIMIT=30

# ── Détection d'anomalie (timeout checker) ───────────────────────────────────
# Warm-up : nombre minimal de pings réussis (7j) avant d'autoriser une alerte
# "slowdown". Évite les faux positifs sur un monitor neuf / naturellement variable.
SLOW_WARMUP_SAMPLES=5
# Reset destructif des queues au démarrage du worker (reseed/dev) : vide AUSSI les
# jobs en attente. Défaut (absent/false) = on préserve le travail en vol au restart.
# DRAIN_QUEUES_ON_BOOT=false

# ── /metrics (Prometheus) ─────────────────────────────────────────────────────
# FERMÉ par défaut (401) pour éviter une fuite d'infos cross-tenant. Pour l'exposer :
#   - METRICS_TOKEN=...   → exige Authorization: Bearer <token> (ou ?token=)
#   - OU METRICS_PUBLIC=true → ouvre /metrics sans auth (réseau interne de confiance UNIQUEMENT)
# METRICS_TOKEN=
# METRICS_PUBLIC=false

# ── SSO forward-auth (Enterprise, optionnel) ─────────────────────────────────
# Pour les déploiements derrière un reverse-proxy SSO (oauth2-proxy, Authelia,
# Pomerium, Cloudflare Access, gateway SAML/OIDC corporate). Le proxy authentifie
# l'humain et injecte son email ; l'app le mappe sur team_members → rôle.
# L'app NE parle JAMAIS à un IdP (zéro egress). Désactivé par défaut.
# SSO_ENABLED=true
#
# Confiance (fail-closed : AU MOINS un des deux requis, sinon header ignoré) :
#   SSO_TRUSTED_PROXIES=10.0.0.10,10.0.0.11   # IP(s) exacte(s) du proxy
#   SSO_SHARED_SECRET=...                       # secret que le proxy doit renvoyer
#   SSO_SECRET_HEADER=X-CronGuard-SSO-Secret    # (défaut)
#
# Identité :
#   SSO_EMAIL_HEADER=X-Forwarded-Email          # (défaut) header injecté par le proxy
#   SSO_ALLOWED_DOMAINS=corp.com,filiale.com    # domaines auto-provisionnés (JIT)
#   SSO_DEFAULT_ROLE=viewer                      # viewer|member|admin — JAMAIS owner
#   SSO_CLIENT_ID=...                            # requis seulement si plusieurs clients

# ── Stripe (optionnel — paiements désactivés si absent) ──────────────────────
# STRIPE_SECRET_KEY=rk_live_...        # clé RESTREINTE recommandée (vs sk_ standard), sans guillemets
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...

# ── Alertes email (optionnel) ────────────────────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...
# SMTP_FROM=alerts@cronguard.io
